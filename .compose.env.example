# Copy to .env in the repository root if it does not already exist.
# This is Compose dotenv syntax, separate from Backend/.env Java properties.
# Replace every placeholder before starting the stack; keep .env untracked.
DB_PASSWORD=replace-with-a-random-database-password
AWS_REGION=replace-with-bucket-region
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_BUCKET=replace-with-private-bucket-name
JWT_SECRET=replace-with-a-unique-random-signing-secret-at-least-32-bytes-long
