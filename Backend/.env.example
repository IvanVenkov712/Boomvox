# Copy to Backend/.env only if you do not already have that file.
# Spring imports this as a Java properties file relative to the working directory.
# Replace the required placeholders; do not add shell quotes or commit real values.
# See ../docs/deployment.md for purposes and OS environment-variable equivalents.

# Required: private S3 bucket and static basic credentials with object access.
aws.region=replace-with-bucket-region
aws.accessKeyId=replace-with-access-key-id
aws.secretAccessKey=replace-with-secret-access-key
aws.s3.bucket=replace-with-private-bucket-name
aws.s3.signedUrlExpiryMinutes=15

# Required for a non-shared signing key: generate random text of at least 32 bytes.
# The application uses the text directly, without Base64 decoding.
jwt.secret=replace-with-a-unique-random-signing-secret-at-least-32-bytes-long
jwt.expiration-ms=3600000

# Optional: override the checked-in development database connection.
# spring.datasource.url=jdbc:postgresql://localhost:5432/postgres?currentSchema=boomvox
# spring.datasource.username=boomvox
# spring.datasource.password=replace-with-local-database-password

# Optional: dev is already the default profile and listens on port 9090.
# spring.profiles.active=dev
# server.port=9090

# OPENAI_API_KEY is referenced by leftover configuration, but recommendations
# use local scoring and do not call an AI provider. See the known problems doc.
